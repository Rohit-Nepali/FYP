// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum userRole {
  USER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String?
  emailVerified Boolean  @default(false)
  emailVerifiedAt DateTime?
  role         userRole @default(USER)
  profileImage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Google Sign-In fields
  googleId            String?
  googleRefreshToken String?
  calendarConnected   Boolean  @default(false)

  sessions            UserSession[]
  passwordResets     PasswordReset[]
  emailVerifications EmailVerification[]
  projectsOwned      Project[]       @relation("ownerProjects")
  projectMemberships ProjectMember[]
  assignedTasks      Task[]          @relation("assignedTasks")
  createdTasks       Task[]          @relation("createdTasks")
  sentProjectInvites ProjectInvite[] @relation("UserProjectInvites")

  uploadedAttachments Attachment[]
  comments            Comment[]
  pushToken           String?
  timezone            String   @default("UTC")
  dailyDigestEnabled  Boolean  @default(true)
  digestHourLocal     Int      @default(19)
  activities          Activity[]
  notifications       Notification[]
  behaviorSignals     UserBehaviorSignal[]
  taskRiskSnapshots   TaskRiskSnapshot[]
  dailyDigestLogs     DailyDigestLog[]
  standaloneStatuses  Status[]
  standalonePriorities Priority[]
}

model EmailVerification {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  token     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model UserSession {
  id           String   @id @default(uuid())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  refreshToken String   @unique
  ipAddress    String?
  deviceInfo   String?
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@index([userId])
}

model PasswordReset {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model Status {
  id        String   @id @default(cuid())
  name      String
  color     String? // Hex color code
  order     Int      @default(0)
  projectId String?  // Optional - null for global statuses
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks Task[]

  @@unique([userId, name])
  @@unique([projectId, name])
  @@index([userId])
  @@index([projectId])
}

model Priority {
  id        String   @id @default(cuid())
  name      String
  color     String? // Hex color code
  order     Int      @default(0)
  projectId String?  // Optional - null for global priorities
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks Task[]

  @@unique([userId, name])
  @@unique([projectId, name])
  @@index([userId])
  @@index([projectId])
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  isCompleted Boolean   @default(false)
  statusId    String?
  status      Status?   @relation(fields: [statusId], references: [id], onDelete: Restrict)
  priorityId  String?
  priority    Priority? @relation(fields: [priorityId], references: [id], onDelete: Restrict)
  dueDate     DateTime?

  creatorId String
  creator   User   @relation("createdTasks", fields: [creatorId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assigneeId String?
  assignee   User?   @relation("assignedTasks", fields: [assigneeId], references: [id], onDelete: SetNull)

  attachments Attachment[]
  comments    Comment[]
  activities  Activity[]
  behaviorSignals UserBehaviorSignal[]
  riskSnapshots TaskRiskSnapshot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creatorId])
  @@index([projectId])
  @@index([assigneeId])
  @@index([statusId])
  @@index([priorityId])
}

model UserBehaviorSignal {
  id         String   @id @default(cuid())
  userId     String
  taskId     String?
  label      String
  confidence Float
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([taskId])
  @@index([createdAt])
  @@index([label])
}

model Project {
  id          String   @id @default(uuid())
  title       String
  description String?
  ownerId     String
  owner       User     @relation("ownerProjects", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  members    ProjectMember[]
  tasks      Task[]
  invites    ProjectInvite[] @relation("projectInvites")
  statuses   Status[]
  priorities Priority[]
  attachments Attachment[]  // Direct attachments to the project
  activities Activity[]

  @@index([ownerId])
}

model ProjectMember {
  id        String   @id @default(uuid())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  role      String   @default("member")
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model ProjectInvite {
  id          String   @id @default(uuid())
  email       String
  role        String   @default("member")
  token       String   @unique
  projectId   String
  invitedById String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   Project @relation("projectInvites", fields: [projectId], references: [id], onDelete: Cascade)
  invitedBy User    @relation("UserProjectInvites", fields: [invitedById], references: [id])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities Activity[]

  @@index([taskId])
  @@index([authorId])
}

model Activity {
  id        String   @id @default(cuid())
  type      String   // "TASK_CREATED", "TASK_UPDATED", "COMMENT_ADDED"
  projectId String
  userId    String
  taskId    String?
  commentId String?
  metadata  Json?    // Additional data like task title, comment preview, changes, etc.
  createdAt DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([createdAt])
  @@index([userId])
}

model Attachment {
  id     String  @id @default(cuid())
  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  projectId String?  // Optional: directly linked to project
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  fileName String
  fileType String?
  fileSize Int?
  fileUrl  String // S3 / Supabase / Local URL

  uploadedBy String
  uploader   User   @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([taskId])
  @@index([projectId])
}

// Task-Calendar Link for Google Calendar sync
model TaskCalendarLink {
  id              String   @id @default(cuid())
  taskId          String   @unique
  calendarEventId String   // Google Calendar event ID
  lastSyncedAt    DateTime @default(now())
  syncDirection   String   @default("both") // "to_google", "from_google", "both"

  @@index([taskId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  isArchived Boolean @default(false)
  data      Json?
  createdAt DateTime @default(now())
  readAt    DateTime?
  ignoredAt DateTime?
  archivedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, isArchived])
  @@index([createdAt])
}

model TaskRiskSnapshot {
  id                 String   @id @default(cuid())
  userId             String
  taskId             String
  risk               String
  probability        Float
  topFactors         Json?
  source             String   @default("on_demand")
  predictedForDateKey String
  createdAt          DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId, predictedForDateKey])
  @@index([userId, predictedForDateKey])
  @@index([taskId, createdAt])
}

model DailyDigestLog {
  id            String   @id @default(cuid())
  userId        String
  digestDateKey String
  timezone      String
  deliveryChannel String @default("in_app")
  payloadHash   String
  sentAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, digestDateKey])
  @@index([digestDateKey])
}
